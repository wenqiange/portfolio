---
import '@fontsource/press-start-2p/400.css';
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import '../styles/fusion-zh.css';
import '../styles/global.css';
import { dicts, locales, pathFor, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = dicts[locale];
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#07070d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {locales.map((l) => <link rel="alternate" hreflang={dicts[l].htmlLang} href={pathFor(l)} />)}
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <script is:inline>
      try { if (localStorage.getItem('scanlines') === 'off') document.documentElement.classList.add('no-scan'); } catch {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
