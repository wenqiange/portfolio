---
import { dicts, locales, pathFor, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = dicts[locale];
---
<a class="skip px" href="#main">{t.hud.skip}</a>
<header class="hud">
  <div class="hud__in wrap">
    <button class="hud__player px" type="button" data-coin aria-describedby="credit">
      <span class="hud__up">{t.hud.player}</span> <span class="hud__who">WENQIANG</span>
    </button>
    <span id="credit" class="hud__credit px">{t.hud.credit} <span data-credit>00</span></span>
    <span class="hud__credit px">HI <span data-hi>0000</span></span>

    <nav class="hud__nav" aria-label={t.hud.nav}>
      <ol>
        {t.worlds.map((w) => (
          <li><a class="px" href={`#${w.id}`} aria-label={`${w.code} ${w.label}`}>{w.code}</a></li>
        ))}
      </ol>
    </nav>

    <div class="hud__tools">
      <ul class="hud__lang" aria-label={t.hud.language}>
        {locales.map((l) => (
          <li>
            <a
              class="px"
              href={pathFor(l)}
              hreflang={dicts[l].htmlLang}
              lang={dicts[l].htmlLang}
              aria-current={l === locale ? 'page' : undefined}
              aria-label={dicts[l].langName}
            >{l === 'zh' ? '中' : l.toUpperCase()}</a>
          </li>
        ))}
      </ul>
      <button class="hud__scan px" type="button" data-scan aria-pressed="true" aria-label={t.hud.scanlines} title={t.hud.scanlines}>FX</button>
    </div>
  </div>
</header>

<style>
  .skip {
    position: absolute; left: var(--gutter); top: -100px; z-index: 200;
    background: var(--yellow); color: var(--black); padding: 12px 16px; font-size: 1rem; text-decoration: none;
  }
  .skip:focus { top: 8px; }

  .hud {
    position: sticky; top: 0; z-index: 50;
    background: var(--black);
    border-bottom: 3px solid var(--blue);
  }
  .hud__in {
    min-height: var(--hud-h);
    display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
    padding-block: 8px;
  }
  .hud__player {
    background: none; border: 0; color: var(--white); cursor: pointer;
    font-size: 1rem; padding: 8px 0;
  }
  .hud__up { color: var(--red); }
  .hud__player:hover .hud__up { color: var(--yellow); }
  .hud__credit { display: none; font-size: 1rem; color: var(--steel); }
  @media (min-width: 1200px) { .hud__credit { display: inline; } }
  .hud__credit span { color: var(--yellow); }

  .hud__nav { display: none; margin-inline: auto; }
  .hud__nav ol, .hud__lang { list-style: none; padding: 0; display: flex; gap: 4px; }
  .hud__nav a, .hud__lang a {
    display: block; font-size: 1rem; color: var(--text); text-decoration: none;
    padding: 8px 10px; border: 2px solid transparent;
  }
  .hud__nav a:hover, .hud__lang a:hover { border-color: var(--cyan); color: var(--cyan); }
  .hud__lang a[aria-current='page'] { color: var(--black); background: var(--magenta); }

  .hud__tools { margin-left: auto; display: flex; align-items: center; gap: 8px; }
  .hud__scan {
    font-size: 1rem; color: var(--steel); background: none; cursor: pointer;
    border: 2px solid var(--deep-2); padding: 8px;
  }
  .hud__scan[aria-pressed='true'] { color: var(--green); border-color: var(--green); box-shadow: var(--bloom) rgb(61 220 104 / 0.35); }

  @media (min-width: 960px) {
    .hud__nav { display: block; }
    .hud__tools { margin-left: 0; }
  }
  .hud__lang a[aria-current='page'] { box-shadow: var(--bloom) rgb(255 79 163 / 0.4); }
  @media (max-width: 559px) {
    .hud__tools { margin-left: 0; width: 100%; justify-content: space-between; }
  }
</style>
